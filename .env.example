# ===== 基础 =====
PORT=3920
DATA_DIR=./data

# ===== 安全：控制台访问密码（强烈建议修改！为空则无密码保护） =====
ADMIN_PASSWORD=

# ===== 浏览器 =====
HEADLESS=true
# 浏览器渠道（playwright 引擎用）：chromium=完整版 Chromium（新无头模式，过 Cloudflare Turnstile 通过率更高，推荐）
# 本机调试可用系统 Chrome：PW_CHANNEL=chrome
PW_CHANNEL=chromium
BROWSER_LOCALE=en-GB
BROWSER_TZ=Europe/London
# 代理（可选）：http://user:pass@host:port
PROXY_URL=

# ===== 浏览器引擎（进阶）=====
# playwright=默认；cloak=CloakBrowser 源码级隐身 Chromium（87 个 C++ 补丁，
# 过 Cloudflare Turnstile 通过率更高；启动失败自动回退 playwright）
# 免费 license key（GitHub 登录，1 并发会话）: https://cloakbrowser.dev/free
# 不填则用旧版免费二进制（v146，会随检测演进而过时）
BROWSER_ENGINE=playwright
CLOAKBROWSER_LICENSE_KEY=
# 人类化操作（鼠标/键盘/滚动轨迹），抗风控建议 true，纯速度可 false
CLOAKBROWSER_HUMANIZE=true
# 按代理 IP 自动设置时区/语言（无代理时不要开，会按服务器 IP 设置）
CLOAKBROWSER_GEOIP=false
# docker build 时预下载 CloakBrowser 二进制（免费版约 200MB）
PRELOAD_CLOAK=0

# ===== 节奏（毫秒） =====
NAV_TIMEOUT_MS=60000
LOGIN_TIMEOUT_MS=90000
CLICK_TIMEOUT_MS=15000
STEP_DELAY_MS=1500
MAX_OFFERS_PER_RUN=20

# ===== 定时任务 =====
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 8 * * *
SCHEDULE_TZ=Europe/London
