# ===== 基础 =====
PORT=3920
DATA_DIR=./data

# ===== 安全：控制台访问密码（强烈建议修改！为空则无密码保护） =====
ADMIN_PASSWORD=

# ===== 浏览器 =====
HEADLESS=true
# 浏览器渠道（playwright 引擎用）：chromium=完整版 Chromium（新无头模式，过 Cloudflare Turnstile 通过率更高，推荐）
# 本机调试可用系统 Chrome：PW_CHANNEL=chrome
PW_CHANNEL=chromium
BROWSER_LOCALE=en-GB
BROWSER_TZ=Europe/London
# 代理（可选）：http://user:pass@host:port
PROXY_URL=

# ===== Resin 粘性代理池（可选，优先于 PROXY_URL）=====
# 涉及具体账号的所有网络请求（登录/提取）都会按账号走 Resin 正代，
# 同一账号始终同一出口 IP（粘性）。Account 用账号 ID（创建时即有、永久稳定）。
# resin_url 含代理地址与 Token，例如 http://127.0.0.1:2260/my-token
RESIN_URL=
# Platform 字段（Resin 业务身份），例如 Default
RESIN_PLATFORM_NAME=Default
# 开了 Resin 且出口在海外时，建议配合 CloakBrowser 按出口 IP 自动设置时区/语言
# CLOAKBROWSER_GEOIP=true

# ===== 浏览器引擎（进阶）=====
# playwright=默认；cloak=CloakBrowser 源码级隐身 Chromium（87 个 C++ 补丁，
# 过 Cloudflare Turnstile 通过率更高；启动失败自动回退 playwright）
# 免费 license key（GitHub 登录，1 并发会话）: https://cloakbrowser.dev/free
# 不填则用旧版免费二进制（v146，会随检测演进而过时）
BROWSER_ENGINE=playwright
CLOAKBROWSER_LICENSE_KEY=
# 人类化操作（鼠标/键盘/滚动轨迹），抗风控建议 true，纯速度可 false
CLOAKBROWSER_HUMANIZE=true
# 按代理 IP 自动设置时区/语言（无代理时不要开，会按服务器 IP 设置）
CLOAKBROWSER_GEOIP=false
# docker build 时预下载 CloakBrowser 二进制（免费版约 200MB）
PRELOAD_CLOAK=0

# ===== FlareSolverr（可选，Cloudflare 拦截兜底）=====
# 登录被 Cloudflare/Turnstile 卡住时，先让 FlareSolverr 过质询拿 cf_clearance 等
# Cookie + 同 UA，再重试登录一次（官方镜像 2026 年仍在活跃维护，v3.5+ 支持 Turnstile）。
# 对接方式按部署场景选：
#
# ① voxi 和 FS 都是 Docker 容器、同一台宿主机（推荐，不走宿主机端口）：
#    先把 FS 容器加入 voxi 的 compose 网络（网络名 = 目录名_default，可用
#    docker network ls 查）：
#      docker network connect sb_default flaresolverr
#    然后这里填：FLARESOLVERR_URL=http://flaresolverr:8191/v1
#    （fs 容器重建后需重跑一次 connect；voxi 侧 rebuild 不受影响）
#
# ② FS 在宿主机但端口只绑了 127.0.0.1（docker run -p 127.0.0.1:8191:8191）时
#    host.docker.internal 方案【不通】，要么用①要么把端口改绑 0.0.0.0
#
# ③ voxi 本地直接跑（npm start）：FLARESOLVERR_URL=http://127.0.0.1:8191/v1
#
# 留空或设 off = 禁用。开了 RESIN/PROXY_URL 时 FlareSolverr 会自动走同一代理
FLARESOLVERR_URL=http://flaresolverr:8191/v1
# 整体 HTTP 请求超时（毫秒）
FLARESOLVERR_TIMEOUT_MS=90000
# 传给 FlareSolverr 的质询求解超时（毫秒）
FLARESOLVERR_MAX_TIMEOUT=60000

# ===== 节奏（毫秒） =====
NAV_TIMEOUT_MS=60000
LOGIN_TIMEOUT_MS=90000
CLICK_TIMEOUT_MS=15000
STEP_DELAY_MS=1500
MAX_OFFERS_PER_RUN=20

# ===== 定时任务 =====
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 8 * * *
SCHEDULE_TZ=Europe/London
