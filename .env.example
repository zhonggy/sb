# ===== 基础 =====
PORT=3000
DATA_DIR=./data

# ===== 安全：控制台访问密码（强烈建议修改！为空则无密码保护） =====
ADMIN_PASSWORD=

# ===== 浏览器 =====
HEADLESS=true
# 本机调试可用系统 Chrome：PW_CHANNEL=chrome
PW_CHANNEL=
BROWSER_LOCALE=en-GB
BROWSER_TZ=Europe/London
# 代理（可选）：http://user:pass@host:port
PROXY_URL=

# ===== 节奏（毫秒） =====
NAV_TIMEOUT_MS=60000
LOGIN_TIMEOUT_MS=90000
CLICK_TIMEOUT_MS=15000
STEP_DELAY_MS=1500
MAX_OFFERS_PER_RUN=20

# ===== 定时任务 =====
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 8 * * *
SCHEDULE_TZ=Europe/London
